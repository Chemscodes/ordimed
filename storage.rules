rules_version = '2';

// Même logique de propriété que firestore.rules : le cabinet est
// l'utilisateur Firebase connecté, et chaque cabinet ne voit que ses
// propres fichiers.
service firebase.storage {
  match /b/{bucket}/o {
    match /cabinets/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}

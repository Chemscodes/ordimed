rules_version = '2';

// =============================================================
//  Ordimed — regles de securite Firestore
//
//  Principe : un compte Firebase Auth = un cabinet = un espace
//  cabinets/{uid}. Personne ne lit ni n'ecrit hors du sien.
//
//  Deploiement :  firebase deploy --only firestore:rules
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Proprietaire de l'espace : l'uid du chemin est celui du connecte.
    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------
    //  L'espace complet d'un cabinet
    //
    //  Couvre cabinets/{uid} et TOUT ce qui pend dessous :
    //  profiles, patients, forms, versements, rendezvous,
    //  salle_attente, purchases, daily_stats.
    //
    //  Le controle porte sur le chemin et non sur un champ, ce qui
    //  le rend insensible a ce que l'app envoie : un poste ne peut
    //  pas atteindre un autre cabinet, meme en forgeant parentUid.
    // ---------------------------------------------------------
    match /cabinets/{uid} {
      allow read, write: if owner(uid);

      match /{sousDocument=**} {
        allow read, write: if owner(uid);
      }
    }

    // ---------------------------------------------------------
    //  Journal d'erreurs
    //
    //  En ecriture seule depuis l'app : un poste depose son rapport
    //  et n'a aucune raison de relire ceux des autres. La lecture se
    //  fait depuis la console Firebase.
    //
    //  parentUid doit etre celui du connecte, sinon un poste pourrait
    //  remplir le journal d'un autre cabinet.
    // ---------------------------------------------------------
    match /errors/{errorId} {
      allow create: if signedIn()
                    && request.resource.data.parentUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ---------------------------------------------------------
    //  Ancienne arborescence, conservee en lecture pour son
    //  proprietaire.
    //
    //  La premiere version de l'app ecrivait sous users/{uid}, en
    //  sous-collections par profil. Plus rien n'y ecrit, mais les
    //  cabinets d'avant la bascule y ont encore leurs dossiers : les
    //  couper rendrait ces donnees inaccessibles a ceux a qui elles
    //  appartiennent, y compris pour une reprise.
    // ---------------------------------------------------------
    match /users/{uid} {
      allow read: if owner(uid);

      match /{sousDocument=**} {
        allow read: if owner(uid);
      }
    }

    // ---------------------------------------------------------
    //  Tout le reste est refuse par defaut.
    // ---------------------------------------------------------
  }
}
